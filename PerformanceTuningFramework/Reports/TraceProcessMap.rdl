            <TablixRow>
              <Height>2.90in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Chart Name="chtBuckets">
                      <DataSetName>Buckets</DataSetName>
                      <NoRowsMessage>No busy time in this window.</NoRowsMessage>
                      <ChartCategoryHierarchy>
                        <ChartMembers>
                          <ChartMember>
                            <Group Name="BucketCategory">
                              <GroupExpressions>
                                <GroupExpression>=Fields!BucketStart.Value</GroupExpression>
                              </GroupExpressions>
                            </Group>
                            <SortExpressions>
                              <SortExpression>
                                <Value>=Fields!BucketStart.Value</Value>
                                <Direction>Ascending</Direction>
                              </SortExpression>
                            </SortExpressions>
                            <Label>=Code.Fmt(Fields!BucketStart.Value, "MM-dd HH:mm")</Label>
                          </ChartMember>
                        </ChartMembers>
                      </ChartCategoryHierarchy>
                      <ChartSeriesHierarchy>
                        <ChartMembers>
                          <ChartMember>
                            <Group Name="BucketSeries">
                              <GroupExpressions>
                                <GroupExpression>=Fields!ApplicationName.Value</GroupExpression>
                              </GroupExpressions>
                            </Group>
                            <SortExpressions>
                              <SortExpression>
                                <Value>=Fields!ApplicationName.Value</Value>
                                <Direction>Ascending</Direction>
                              </SortExpression>
                            </SortExpressions>
                            <Label>=Code.Clip(Fields!ApplicationName.Value, 40)</Label>
                          </ChartMember>
                        </ChartMembers>
                      </ChartSeriesHierarchy>
                      <ChartData>
                        <ChartSeriesCollection>
                          <ChartSeries Name="BusySeconds">
                            <ChartDataPoints>
                              <ChartDataPoint>
                                <ChartDataPointValues>
                                  <Y>=Fields!TotalSeconds.Value</Y>
                                </ChartDataPointValues>
                                <ToolTip>=Code.Clip(Fields!ApplicationName.Value, 40) &amp; "  " &amp; Code.Fmt(Fields!BucketStart.Value, "yyyy-MM-dd HH:mm") &amp; "  " &amp; Code.Fmt(Fields!TotalSeconds.Value, "0.000") &amp; " s"</ToolTip>
                              </ChartDataPoint>
                            </ChartDataPoints>
                            <Type>Column</Type>
                            <Subtype>Stacked</Subtype>
                            <ChartAreaName>BucketArea</ChartAreaName>
                            <ValueAxisName>BusyAxis</ValueAxisName>
                            <CategoryAxisName>BucketAxis</CategoryAxisName>
                            <LegendName>BucketLegend</LegendName>
                          </ChartSeries>
                        </ChartSeriesCollection>
                      </ChartData>
                      <ChartAreas>
                        <ChartArea Name="BucketArea">
                          <ChartCategoryAxes>
                            <ChartAxis Name="BucketAxis">
                              <Visible>true</Visible>
                              <Style>
                                <FontFamily>=Parameters!FontName.Value</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>#333333</Color>
                              </Style>
                              <ChartAxisTitle>
                                <Caption>Bucket start</Caption>
                                <Style>
                                  <FontFamily>=Parameters!FontName.Value</FontFamily>
                                  <FontSize>8pt</FontSize>
                                  <FontWeight>Bold</FontWeight>
                                  <Color>#1F4E79</Color>
                                </Style>
                              </ChartAxisTitle>
