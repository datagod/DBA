        <CommandType>Text</CommandType>
        <CommandText>SET NOCOUNT ON;
IF NULLIF(@TraceTable, N'') IS NULL
SELECT
    DatabaseName      = CONVERT(nvarchar(128), NULL),
    EventCount        = CONVERT(int, NULL),
    TotalSeconds      = CONVERT(decimal(18, 3), NULL),
    AvgSeconds        = CONVERT(decimal(18, 3), NULL),
    MaxSeconds        = CONVERT(decimal(18, 3), NULL),
    PercentOfDuration = CONVERT(decimal(9, 1), NULL),
    PercentOfCpu      = CONVERT(decimal(9, 1), NULL),
    FirstSeen         = CONVERT(datetime, NULL),
    LastSeen          = CONVERT(datetime, NULL),
    DistinctSpids     = CONVERT(int, NULL)
WHERE 1 = 0
ELSE
EXEC dbo.ShowTraceSourceBreakdown
    @TraceTable = @TraceTable,
    @StartTime = @StartTime,
    @EndTime = @EndTime,
    @DatabaseName = @DatabaseName,
    @ApplicationName = @ApplicationName,
    @GroupBy = N'Database',
    @ReturnOverview = 0,
    @ReturnApplication = 0,
    @ReturnHost = 0,
    @ReturnLogin = 0,
    @ReturnDatabase = 1,
    @ReturnObject = 0,
    @ReturnCombined = 0,
    @ReturnBucket = 0
</CommandText>
        <QueryParameters>
          <QueryParameter Name="@TraceTable">
            <Value DataType="String">=Parameters!TraceTable.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@StartTime">
            <Value DataType="DateTime">=Parameters!StartTime.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndTime">
            <Value DataType="DateTime">=Parameters!EndTime.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@DatabaseName">
            <Value DataType="String">=Parameters!DatabaseFilter.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@ApplicationName">
            <Value DataType="String">=Parameters!ApplicationName.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <Timeout>600</Timeout>
      </Query>
