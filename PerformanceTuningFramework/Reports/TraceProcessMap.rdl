    </DataSet>
    <DataSet Name="Buckets">
      <Query>
        <DataSourceName>TraceData</DataSourceName>
        <CommandType>Text</CommandType>
        <CommandText>SET NOCOUNT ON;
IF NULLIF(@TraceTable, N'') IS NULL
SELECT
    BucketStart             = CONVERT(datetime, NULL),
    BucketEnd               = CONVERT(datetime, NULL),
    RankInBucket            = CONVERT(int, NULL),
    ApplicationName         = CONVERT(nvarchar(128), NULL),
    EventCount              = CONVERT(int, NULL),
    TotalSeconds            = CONVERT(decimal(18, 3), NULL),
    PercentOfBucketDuration = CONVERT(decimal(9, 1), NULL),
    PercentOfDuration       = CONVERT(decimal(9, 1), NULL)
WHERE 1 = 0
ELSE
EXEC dbo.ShowTraceSourceBreakdown
    @TraceTable = @TraceTable,
    @StartTime = @StartTime,
    @EndTime = @EndTime,
    @DatabaseName = @DatabaseName,
    @ApplicationName = @ApplicationName,
    @BucketMinutes = @BucketMinutes,
    @GroupBy = N'Bucket',
    @TopN = 8,
    @ReturnOverview = 0,
    @ReturnApplication = 0,
    @ReturnHost = 0,
    @ReturnLogin = 0,
    @ReturnDatabase = 0,
    @ReturnObject = 0,
    @ReturnCombined = 0,
    @ReturnBucket = 1
</CommandText>
        <QueryParameters>
          <QueryParameter Name="@TraceTable">
            <Value DataType="String">=Parameters!TraceTable.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@StartTime">
            <Value DataType="DateTime">=Parameters!StartTime.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndTime">
            <Value DataType="DateTime">=Parameters!EndTime.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@DatabaseName">
            <Value DataType="String">=Parameters!DatabaseFilter.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@ApplicationName">
            <Value DataType="String">=Parameters!ApplicationName.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@BucketMinutes">
            <Value DataType="Integer">=Parameters!BucketMinutes.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <Timeout>600</Timeout>
      </Query>
      <Fields>
        <Field Name="BucketStart">
          <DataField>BucketStart</DataField>
        </Field>
        <Field Name="BucketEnd">
          <DataField>BucketEnd</DataField>
        </Field>
        <Field Name="RankInBucket">
          <DataField>RankInBucket</DataField>
        </Field>
        <Field Name="ApplicationName">
          <DataField>ApplicationName</DataField>
        </Field>
        <Field Name="EventCount">
          <DataField>EventCount</DataField>
        </Field>
        <Field Name="TotalSeconds">
          <DataField>TotalSeconds</DataField>
        </Field>
        <Field Name="PercentOfBucketDuration">
          <DataField>PercentOfBucketDuration</DataField>
        </Field>
        <Field Name="PercentOfDuration">
          <DataField>PercentOfDuration</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TraceTables">
      <Query>
        <DataSourceName>TraceData</DataSourceName>
        <CommandType>Text</CommandType>
        <CommandText>SET NOCOUNT ON;
IF NULLIF(@TraceTable, N'') IS NOT NULL
    SELECT
        TraceTable   = CONVERT(nvarchar(400), NULL),
        [RowCount]   = CONVERT(bigint, NULL),
        MinStartTime = CONVERT(datetime, NULL),
        MaxStartTime = CONVERT(datetime, NULL),
        IsCurrent    = CONVERT(bit, NULL)
    WHERE 1 = 0
ELSE
BEGIN
    CREATE TABLE #Candidate
    (
        FullName     nvarchar(400) NOT NULL PRIMARY KEY,
        [RowCount]   bigint        NOT NULL,
        IsCurrent    bit           NOT NULL,
        MinStartTime datetime      NULL,
        MaxStartTime datetime      NULL
    );

    INSERT INTO #Candidate (FullName, [RowCount], IsCurrent)
    SELECT
        QUOTENAME(s.name) + N'.' + QUOTENAME(t.name),
        SUM(CONVERT(bigint, p.rows)),
        1
    FROM sys.tables AS t
    INNER JOIN sys.schemas AS s
        ON s.schema_id = t.schema_id
    INNER JOIN sys.partitions AS p
        ON p.object_id = t.object_id
       AND p.index_id IN (0, 1)
    WHERE t.is_ms_shipped = 0
      AND EXISTS (
            SELECT 1
            FROM sys.columns AS c
            WHERE c.object_id = t.object_id
              AND c.name COLLATE Latin1_General_CI_AS = N'EventClass')
      AND EXISTS (
            SELECT 1
            FROM sys.columns AS c
            WHERE c.object_id = t.object_id
              AND c.name COLLATE Latin1_General_CI_AS = N'StartTime')
      AND (
            EXISTS (
                SELECT 1
                FROM sys.columns AS c
                WHERE c.object_id = t.object_id
                  AND c.name COLLATE Latin1_General_CI_AS = N'TextData')
            OR EXISTS (
                SELECT 1
                FROM sys.columns AS c
                WHERE c.object_id = t.object_id
                  AND c.name COLLATE Latin1_General_CI_AS = N'Duration')
          )
    GROUP BY s.name, t.name;

    DECLARE @db sysname;
    DECLARE @sql nvarchar(max);
    DECLARE dbs CURSOR LOCAL FAST_FORWARD FOR
        SELECT TOP (24) d.name
        FROM sys.databases AS d
        WHERE d.database_id > 4
          AND d.state = 0
          AND NOT (d.name = DB_NAME())
          AND HAS_DBACCESS(d.name) = 1
        ORDER BY d.name;

    OPEN dbs;
    FETCH NEXT FROM dbs INTO @db;
    WHILE @@FETCH_STATUS = 0
    BEGIN
        BEGIN TRY
            SET @sql = N'
INSERT INTO #Candidate (FullName, [RowCount], IsCurrent)
SELECT TOP (40)
    QUOTENAME(@db) + N''.'' + QUOTENAME(s.name) + N''.'' + QUOTENAME(t.name),
    SUM(CONVERT(bigint, p.rows)),
    0
FROM ' + QUOTENAME(@db) + N'.sys.tables AS t
INNER JOIN ' + QUOTENAME(@db) + N'.sys.schemas AS s
    ON s.schema_id = t.schema_id
INNER JOIN ' + QUOTENAME(@db) + N'.sys.partitions AS p
    ON p.object_id = t.object_id
   AND p.index_id IN (0, 1)
WHERE t.is_ms_shipped = 0
  AND EXISTS (
        SELECT 1
        FROM ' + QUOTENAME(@db) + N'.sys.columns AS c
        WHERE c.object_id = t.object_id
          AND c.name COLLATE Latin1_General_CI_AS = N''EventClass'')
  AND EXISTS (
        SELECT 1
        FROM ' + QUOTENAME(@db) + N'.sys.columns AS c
        WHERE c.object_id = t.object_id
          AND c.name COLLATE Latin1_General_CI_AS = N''StartTime'')
  AND (
        EXISTS (
            SELECT 1
            FROM ' + QUOTENAME(@db) + N'.sys.columns AS c
            WHERE c.object_id = t.object_id
              AND c.name COLLATE Latin1_General_CI_AS = N''TextData'')
        OR EXISTS (
            SELECT 1
            FROM ' + QUOTENAME(@db) + N'.sys.columns AS c
            WHERE c.object_id = t.object_id
              AND c.name COLLATE Latin1_General_CI_AS = N''Duration'')
      )
  AND NOT EXISTS (
        SELECT 1
        FROM #Candidate AS already
        WHERE already.FullName = QUOTENAME(@db) + N''.'' + QUOTENAME(s.name) + N''.'' + QUOTENAME(t.name))
GROUP BY s.name, t.name
ORDER BY SUM(CONVERT(bigint, p.rows)) DESC, s.name, t.name;';
            EXEC sp_executesql @sql, N'@db sysname', @db = @db;
        END TRY
        BEGIN CATCH
        END CATCH;
        FETCH NEXT FROM dbs INTO @db;
    END
    CLOSE dbs;
    DEALLOCATE dbs;

    ;WITH Ranked AS
    (
        SELECT
            FullName,
            rn = ROW_NUMBER() OVER (ORDER BY IsCurrent DESC, [RowCount] DESC, FullName)
        FROM #Candidate
    )
    DELETE c
    FROM #Candidate AS c
    INNER JOIN Ranked AS r
        ON r.FullName = c.FullName
    WHERE r.rn > 40;

    DECLARE @full nvarchar(400);
    DECLARE @min datetime;
    DECLARE @max datetime;
    DECLARE tables CURSOR LOCAL FAST_FORWARD FOR
        SELECT FullName FROM #Candidate;
    OPEN tables;
    FETCH NEXT FROM tables INTO @full;
    WHILE @@FETCH_STATUS = 0
    BEGIN
        BEGIN TRY
            SET @min = NULL;
            SET @max = NULL;
            SET @sql = N'SELECT @min = MIN(StartTime), @max = MAX(StartTime) FROM ' + @full + N' WITH (NOLOCK);';
            EXEC sp_executesql
                @sql,
                N'@min datetime OUTPUT, @max datetime OUTPUT',
                @min = @min OUTPUT,
                @max = @max OUTPUT;
            UPDATE #Candidate
            SET MinStartTime = @min,
                MaxStartTime = @max
            WHERE FullName = @full;
        END TRY
        BEGIN CATCH
        END CATCH;
        FETCH NEXT FROM tables INTO @full;
    END
    CLOSE tables;
    DEALLOCATE tables;

    SELECT
        TraceTable   = FullName,
        [RowCount],
        MinStartTime,
        MaxStartTime,
        IsCurrent
    FROM #Candidate
    ORDER BY IsCurrent DESC, [RowCount] DESC, FullName;
END</CommandText>
        <QueryParameters>
          <QueryParameter Name="@TraceTable">
            <Value DataType="String">=Parameters!TraceTable.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <Timeout>600</Timeout>
      </Query>
      <Fields>
        <Field Name="TraceTable">
          <DataField>TraceTable</DataField>
        </Field>
        <Field Name="RowCount">
          <DataField>RowCount</DataField>
        </Field>
        <Field Name="MinStartTime">
          <DataField>MinStartTime</DataField>
        </Field>
        <Field Name="MaxStartTime">
          <DataField>MaxStartTime</DataField>
        </Field>
        <Field Name="IsCurrent">
          <DataField>IsCurrent</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
