                              <PreventWordWrap>true</PreventWordWrap>
                              <LabelsAutoFitDisabled>false</LabelsAutoFitDisabled>
                              <MinFontSize>7pt</MinFontSize>
                              <MaxFontSize>8pt</MaxFontSize>
                              <ChartMajorGridLines>
                                <Enabled>true</Enabled>
                                <Style>
                                  <Color>#E6E6E6</Color>
                                </Style>
                              </ChartMajorGridLines>
                            </ChartAxis>
                          </ChartCategoryAxes>
                          <ChartValueAxes>
                            <ChartAxis Name="BusyAxis">
                              <Visible>true</Visible>
                              <Style>
                                <FontFamily>=Parameters!FontName.Value</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>#333333</Color>
                              </Style>
                              <ChartAxisTitle>
                                <Caption>Busy seconds</Caption>
                                <Style>
                                  <FontFamily>=Parameters!FontName.Value</FontFamily>
                                  <FontSize>8pt</FontSize>
                                  <FontWeight>Bold</FontWeight>
                                  <Color>#1F4E79</Color>
                                </Style>
                              </ChartAxisTitle>
                              <IncludeZero>true</IncludeZero>
                              <PreventWordWrap>true</PreventWordWrap>
                              <LabelsAutoFitDisabled>false</LabelsAutoFitDisabled>
                              <MinFontSize>7pt</MinFontSize>
                              <MaxFontSize>8pt</MaxFontSize>
                              <ChartMajorGridLines>
                                <Enabled>true</Enabled>
                                <Style>
                                  <Color>#E6E6E6</Color>
                                </Style>
                              </ChartMajorGridLines>
                            </ChartAxis>
                          </ChartValueAxes>
                        </ChartArea>
                      </ChartAreas>
                      <ChartLegends>
                        <ChartLegend Name="BucketLegend">
                          <Position>Bottom</Position>
                          <DockToChartArea>BucketArea</DockToChartArea>
                          <DockOutsideChartArea>true</DockOutsideChartArea>
