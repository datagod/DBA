              <TextRuns>
                <TextRun>
                  <Value>=IIf(IsNothing(Parameters!TraceTable.Value) Or Parameters!TraceTable.Value = "", "No table selected. Listed tables have EventClass and StartTime, plus TextData or Duration.", "Table " &amp; Code.Clip(Parameters!TraceTable.Value, 70) &amp; "    Database LIKE " &amp; IIf(IsNothing(Parameters!DatabaseFilter.Value), "(all)", Code.Clip(Parameters!DatabaseFilter.Value, 40)) &amp; "    Application LIKE " &amp; IIf(IsNothing(Parameters!ApplicationName.Value), "(all)", Code.Clip(Parameters!ApplicationName.Value, 40)) &amp; "    Buckets " &amp; CStr(Parameters!BucketMinutes.Value) &amp; " min")</Value>
                </TextRun>
              </TextRuns>
            </Paragraph>
          </Paragraphs>
          <CanGrow>false</CanGrow>
          <CanShrink>false</CanShrink>
          <KeepTogether>true</KeepTogether>
        </Textbox>
