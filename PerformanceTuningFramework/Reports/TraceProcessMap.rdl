  <ReportParameters>
    <ReportParameter Name="TraceTable">
      <DataType>String</DataType>
      <Nullable>false</Nullable>
      <AllowBlank>false</AllowBlank>
      <Prompt>Trace table</Prompt>
      <UsedInQuery>True</UsedInQuery>
    </ReportParameter>
    <ReportParameter Name="StartTime">
      <DataType>DateTime</DataType>
      <Nullable>true</Nullable>
      <Prompt>Start time</Prompt>
      <UsedInQuery>True</UsedInQuery>
    </ReportParameter>
    <ReportParameter Name="EndTime">
      <DataType>DateTime</DataType>
      <Nullable>true</Nullable>
      <Prompt>End time</Prompt>
      <UsedInQuery>True</UsedInQuery>
    </ReportParameter>
    <ReportParameter Name="DatabaseFilter">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <AllowBlank>false</AllowBlank>
      <Prompt>Database name (LIKE)</Prompt>
      <UsedInQuery>True</UsedInQuery>
    </ReportParameter>
    <ReportParameter Name="ApplicationName">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <AllowBlank>false</AllowBlank>
      <Prompt>Application name (LIKE)</Prompt>
      <UsedInQuery>True</UsedInQuery>
    </ReportParameter>
    <ReportParameter Name="BucketMinutes">
      <DataType>Integer</DataType>
      <Nullable>false</Nullable>
      <DefaultValue>
        <Values>
          <Value>15</Value>
        </Values>
      </DefaultValue>
      <Prompt>Bucket minutes</Prompt>
      <UsedInQuery>True</UsedInQuery>
    </ReportParameter>
    <ReportParameter Name="ObjectName">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <DefaultValue>
        <Values>
          <Value />
        </Values>
      </DefaultValue>
      <AllowBlank>true</AllowBlank>
      <Prompt>ObjectName</Prompt>
      <Hidden>true</Hidden>
      <UsedInQuery>False</UsedInQuery>
    </ReportParameter>
    <ReportParameter Name="ObjectTypeName">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <DefaultValue>
        <Values>
          <Value />
        </Values>
      </DefaultValue>
      <AllowBlank>true</AllowBlank>
      <Prompt>ObjectTypeName</Prompt>
      <Hidden>true</Hidden>
      <UsedInQuery>False</UsedInQuery>
    </ReportParameter>
    <ReportParameter Name="Filtered">
      <DataType>Boolean</DataType>
      <Nullable>true</Nullable>
      <DefaultValue>
        <Values>
          <Value>false</Value>
        </Values>
      </DefaultValue>
      <Prompt>Filtered</Prompt>
      <Hidden>true</Hidden>
      <UsedInQuery>False</UsedInQuery>
    </ReportParameter>
    <ReportParameter Name="ServerName">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <DefaultValue>
        <Values>
          <Value />
        </Values>
      </DefaultValue>
      <AllowBlank>true</AllowBlank>
      <Prompt>ServerName</Prompt>
      <Hidden>true</Hidden>
      <UsedInQuery>False</UsedInQuery>
    </ReportParameter>
    <ReportParameter Name="FontName">
      <DataType>String</DataType>
      <Nullable>false</Nullable>
      <DefaultValue>
        <Values>
          <Value>Tahoma</Value>
        </Values>
      </DefaultValue>
      <AllowBlank>false</AllowBlank>
      <Prompt>FontName</Prompt>
      <Hidden>true</Hidden>
      <UsedInQuery>False</UsedInQuery>
    </ReportParameter>
    <ReportParameter Name="DatabaseName">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <DefaultValue>
        <Values>
          <Value />
        </Values>
      </DefaultValue>
      <AllowBlank>true</AllowBlank>
      <Prompt>DatabaseName</Prompt>
      <Hidden>true</Hidden>
      <UsedInQuery>False</UsedInQuery>
    </ReportParameter>
  </ReportParameters>
  <Body>
    <ReportItems>
      <Tablix Name="tblReport">
        <DataSetName>Overview</DataSetName>
        <NoRowsMessage>No overview row.</NoRowsMessage>
        <TablixBody>
          <TablixColumns>
            <TablixColumn>
              <Width>10.5in</Width>
            </TablixColumn>
          </TablixColumns>
          <TablixRows>
            <TablixRow>
              <Height>0.70in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Rectangle Name="rectTitle">
                      <KeepTogether>true</KeepTogether>
                      <Width>10.5in</Width>
                      <Height>0.70in</Height>
                      <ReportItems>
                        <Textbox Name="txtTitle">
                          <Top>0in</Top>
                          <Left>0in</Left>
                          <Height>0.36in</Height>
                          <Width>7.1in</Width>
                          <Style>
                            <FontFamily>=Parameters!FontName.Value</FontFamily>
                            <FontSize>18pt</FontSize>
                            <FontWeight>Bold</FontWeight>
                            <TextAlign>Left</TextAlign>
                            <VerticalAlign>Middle</VerticalAlign>
                            <Color>#1F4E79</Color>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>1pt</PaddingTop>
                            <PaddingBottom>1pt</PaddingBottom>
                          </Style>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Trace process map</Value>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <CanGrow>false</CanGrow>
                          <CanShrink>false</CanShrink>
                          <KeepTogether>true</KeepTogether>
                        </Textbox>
                        <Textbox Name="txtContext">
                          <Top>0in</Top>
                          <Left>7.1in</Left>
                          <Height>0.36in</Height>
                          <Width>3.4in</Width>
                          <Style>
                            <FontFamily>=Parameters!FontName.Value</FontFamily>
                            <FontSize>9pt</FontSize>
                            <TextAlign>Right</TextAlign>
                            <VerticalAlign>Middle</VerticalAlign>
                            <Color>#1F4E79</Color>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>1pt</PaddingTop>
                            <PaddingBottom>1pt</PaddingBottom>
                          </Style>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Code.Clip(Parameters!ServerName.Value, 40) &amp; IIf(IsNothing(Parameters!DatabaseName.Value) Or Parameters!DatabaseName.Value = "", "", "   " &amp; Parameters!DatabaseName.Value)</Value>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <CanGrow>false</CanGrow>
                          <CanShrink>false</CanShrink>
                          <KeepTogether>true</KeepTogether>
                        </Textbox>
                        <Textbox Name="txtSubtitle">
                          <Top>0.36in</Top>
                          <Left>0in</Left>
                          <Height>0.28in</Height>
                          <Width>10.5in</Width>
                          <Style>
                            <FontFamily>=Parameters!FontName.Value</FontFamily>
                            <FontSize>8pt</FontSize>
                            <TextAlign>Left</TextAlign>
                            <VerticalAlign>Middle</VerticalAlign>
                            <Color>#595959</Color>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>1pt</PaddingTop>
                            <PaddingBottom>1pt</PaddingBottom>
                          </Style>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>="Table " &amp; Code.Clip(Parameters!TraceTable.Value, 70) &amp; "    Database LIKE " &amp; IIf(IsNothing(Parameters!DatabaseFilter.Value), "(all)", Code.Clip(Parameters!DatabaseFilter.Value, 40)) &amp; "    Application LIKE " &amp; IIf(IsNothing(Parameters!ApplicationName.Value), "(all)", Code.Clip(Parameters!ApplicationName.Value, 40)) &amp; "    Buckets " &amp; CStr(Parameters!BucketMinutes.Value) &amp; " min"</Value>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <CanGrow>false</CanGrow>
                          <CanShrink>false</CanShrink>
                          <KeepTogether>true</KeepTogether>
                        </Textbox>
                      </ReportItems>
                    </Rectangle>
                  </CellContents>
                </TablixCell>
              </TablixCells>
            </TablixRow>
            <TablixRow>
              <Height>0.76in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Rectangle Name="rectKpi">
                      <KeepTogether>true</KeepTogether>
                      <Width>10.5in</Width>
                      <Height>0.72in</Height>
                      <ReportItems>
                        <Textbox Name="txtKpiWindow">
                          <Top>0in</Top>
                          <Left>0in</Left>
                          <Height>0.70in</Height>
                          <Width>2.02in</Width>
                          <Style>
                            <Border>
                              <Color>#1F4E79</Color>
                              <Style>Solid</Style>
                              <Width>0.5pt</Width>
                            </Border>
                            <BackgroundColor>#F7FBFE</BackgroundColor>
                            <FontFamily>=Parameters!FontName.Value</FontFamily>
                            <FontSize>9pt</FontSize>
                            <FontWeight>Bold</FontWeight>
                            <TextAlign>Left</TextAlign>
                            <VerticalAlign>Middle</VerticalAlign>
                            <Color>#1F4E79</Color>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>1pt</PaddingTop>
                            <PaddingBottom>1pt</PaddingBottom>
                          </Style>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>="Trace window" &amp; vbCrLf &amp; Code.Fmt(Fields!CapturedFrom.Value, "yyyy-MM-dd HH:mm") &amp; "  to  " &amp; Code.Fmt(Fields!CapturedTo.Value, "yyyy-MM-dd HH:mm")</Value>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <CanGrow>false</CanGrow>
                          <CanShrink>false</CanShrink>
                          <KeepTogether>true</KeepTogether>
                        </Textbox>
                        <Textbox Name="txtKpiElapsed">
                          <Top>0in</Top>
                          <Left>2.12in</Left>
                          <Height>0.70in</Height>
                          <Width>2.02in</Width>
                          <Style>
                            <Border>
                              <Color>#1F4E79</Color>
                              <Style>Solid</Style>
                              <Width>0.5pt</Width>
                            </Border>
                            <BackgroundColor>#F7FBFE</BackgroundColor>
                            <FontFamily>=Parameters!FontName.Value</FontFamily>
                            <FontSize>9pt</FontSize>
                            <FontWeight>Bold</FontWeight>
                            <TextAlign>Left</TextAlign>
                            <VerticalAlign>Middle</VerticalAlign>
                            <Color>#1F4E79</Color>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>1pt</PaddingTop>
                            <PaddingBottom>1pt</PaddingBottom>
                          </Style>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>="Elapsed seconds" &amp; vbCrLf &amp; Code.Fmt(Fields!ElapsedSeconds.Value, "N0")</Value>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <CanGrow>false</CanGrow>
                          <CanShrink>false</CanShrink>
                          <KeepTogether>true</KeepTogether>
                        </Textbox>
                        <Textbox Name="txtKpiBusy">
                          <Top>0in</Top>
                          <Left>4.24in</Left>
                          <Height>0.70in</Height>
                          <Width>2.02in</Width>
                          <Style>
                            <Border>
                              <Color>#1F4E79</Color>
                              <Style>Solid</Style>
                              <Width>0.5pt</Width>
                            </Border>
                            <BackgroundColor>#F7FBFE</BackgroundColor>
                            <FontFamily>=Parameters!FontName.Value</FontFamily>
                            <FontSize>9pt</FontSize>
                            <FontWeight>Bold</FontWeight>
                            <TextAlign>Left</TextAlign>
                            <VerticalAlign>Middle</VerticalAlign>
                            <Color>#1F4E79</Color>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>1pt</PaddingTop>
                            <PaddingBottom>1pt</PaddingBottom>
                          </Style>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>="Busy seconds" &amp; vbCrLf &amp; Code.Fmt(Fields!BusySeconds.Value, "N3")</Value>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <CanGrow>false</CanGrow>
                          <CanShrink>false</CanShrink>
                          <KeepTogether>true</KeepTogether>
                        </Textbox>
                        <Textbox Name="txtKpiProcesses">
                          <Top>0in</Top>
                          <Left>6.36in</Left>
                          <Height>0.70in</Height>
                          <Width>2.02in</Width>
                          <Style>
                            <Border>
                              <Color>#1F4E79</Color>
                              <Style>Solid</Style>
                              <Width>0.5pt</Width>
                            </Border>
                            <BackgroundColor>#F7FBFE</BackgroundColor>
                            <FontFamily>=Parameters!FontName.Value</FontFamily>
                            <FontSize>9pt</FontSize>
                            <FontWeight>Bold</FontWeight>
                            <TextAlign>Left</TextAlign>
                            <VerticalAlign>Middle</VerticalAlign>
                            <Color>#1F4E79</Color>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>1pt</PaddingTop>
                            <PaddingBottom>1pt</PaddingBottom>
                          </Style>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>="Processes" &amp; vbCrLf &amp; Code.Fmt(Fields!ProcessCount.Value, "N0")</Value>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <CanGrow>false</CanGrow>
                          <CanShrink>false</CanShrink>
                          <KeepTogether>true</KeepTogether>
                        </Textbox>
                        <Textbox Name="txtKpiTopApp">
                          <Top>0in</Top>
                          <Left>8.48in</Left>
                          <Height>0.70in</Height>
                          <Width>2.02in</Width>
                          <Style>
                            <Border>
                              <Color>#1F4E79</Color>
                              <Style>Solid</Style>
                              <Width>0.5pt</Width>
                            </Border>
                            <BackgroundColor>#F7FBFE</BackgroundColor>
                            <FontFamily>=Parameters!FontName.Value</FontFamily>
                            <FontSize>9pt</FontSize>
                            <FontWeight>Bold</FontWeight>
                            <TextAlign>Left</TextAlign>
                            <VerticalAlign>Middle</VerticalAlign>
                            <Color>#1F4E79</Color>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>1pt</PaddingTop>
                            <PaddingBottom>1pt</PaddingBottom>
                          </Style>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>="Top application" &amp; vbCrLf &amp; IIf(IsNothing(First(Fields!ApplicationName.Value, "ByApplication")), "(none)", Code.Clip(First(Fields!ApplicationName.Value, "ByApplication"), 32) &amp; "  " &amp; Code.Fmt(First(Fields!PercentOfDuration.Value, "ByApplication"), "0.0") &amp; "%")</Value>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <CanGrow>false</CanGrow>
                          <CanShrink>false</CanShrink>
                          <KeepTogether>true</KeepTogether>
                        </Textbox>
                      </ReportItems>
                    </Rectangle>
                  </CellContents>
                </TablixCell>
              </TablixCells>
            </TablixRow>
            <TablixRow>
              <Height>0.62in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="txtNotes">
                      <Height>0.62in</Height>
                      <Width>10.5in</Width>
                      <Style>
                        <FontFamily>=Parameters!FontName.Value</FontFamily>
                        <FontSize>8pt</FontSize>
                        <TextAlign>Left</TextAlign>
                        <VerticalAlign>Top</VerticalAlign>
                        <Color>#595959</Color>
                        <PaddingLeft>2pt</PaddingLeft>
                        <PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop>
                        <PaddingBottom>1pt</PaddingBottom>
                      </Style>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>="Times are seconds. " &amp; Fields!DurationNote.Value &amp; vbCrLf &amp; Fields!BusyRule.Value &amp; vbCrLf &amp; Fields!FilterNote.Value</Value>
                            </TextRun>
                          </TextRuns>
                        </Paragraph>
                      </Paragraphs>
                      <CanGrow>true</CanGrow>
                      <CanShrink>false</CanShrink>
                      <KeepTogether>true</KeepTogether>
                    </Textbox>
                  </CellContents>
                </TablixCell>
              </TablixCells>
            </TablixRow>
            <TablixRow>
              <Height>0.28in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="txtGanttHead">
                      <Height>0.26in</Height>
                      <Width>10.5in</Width>
                      <Style>
                        <FontFamily>=Parameters!FontName.Value</FontFamily>
                        <FontSize>12pt</FontSize>
                        <FontWeight>Bold</FontWeight>
                        <TextAlign>Left</TextAlign>
                        <VerticalAlign>Bottom</VerticalAlign>
                        <Color>#1F4E79</Color>
                        <PaddingLeft>2pt</PaddingLeft>
                        <PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop>
                        <PaddingBottom>1pt</PaddingBottom>
                      </Style>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Processes in start order</Value>
                            </TextRun>
                          </TextRuns>
                        </Paragraph>
                      </Paragraphs>
                      <CanGrow>false</CanGrow>
                      <CanShrink>false</CanShrink>
                      <KeepTogether>true</KeepTogether>
                    </Textbox>
                  </CellContents>
                </TablixCell>
              </TablixCells>
            </TablixRow>
            <TablixRow>
              <Height>3.70in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Chart Name="chtGantt">
                      <DataSetName>Processes</DataSetName>
                      <NoRowsMessage>No processes in this window.</NoRowsMessage>
                      <ChartCategoryHierarchy>
                        <ChartMembers>
                          <ChartMember>
                            <Group Name="GanttProcess">
                              <GroupExpressions>
                                <GroupExpression>=Fields!ProcessId.Value</GroupExpression>
                              </GroupExpressions>
                            </Group>
                            <SortExpressions>
                              <SortExpression>
                                <Value>=Fields!FirstStart.Value</Value>
                                <Direction>Ascending</Direction>
                              </SortExpression>
                            </SortExpressions>
                            <Label>=Code.Clip(Fields!ProcessLabel.Value, 60)</Label>
                          </ChartMember>
                        </ChartMembers>
                      </ChartCategoryHierarchy>
                      <ChartSeriesHierarchy>
                        <ChartMembers>
                          <ChartMember>
                            <Group Name="GanttApplication">
                              <GroupExpressions>
                                <GroupExpression>=Fields!ApplicationName.Value</GroupExpression>
                              </GroupExpressions>
                            </Group>
                            <SortExpressions>
                              <SortExpression>
                                <Value>=Fields!ApplicationName.Value</Value>
                                <Direction>Ascending</Direction>
                              </SortExpression>
                            </SortExpressions>
                            <Label>=Code.Clip(Fields!ApplicationName.Value, 40)</Label>
                          </ChartMember>
                        </ChartMembers>
                      </ChartSeriesHierarchy>
                      <ChartData>
                        <ChartSeriesCollection>
                          <ChartSeries Name="ProcessRange">
                            <ChartDataPoints>
                              <ChartDataPoint>
                                <ChartDataPointValues>
                                  <Low>=Fields!FirstStart.Value</Low>
                                  <High>=Fields!LastEnd.Value</High>
                                </ChartDataPointValues>
                                <ToolTip>="Elapsed " &amp; Code.Fmt(Fields!ElapsedSeconds.Value, "0.000") &amp; " s    busy " &amp; Code.Fmt(Fields!BusyPercent.Value, "0.0") &amp; "%    " &amp; Code.Clip(Fields!MainStatement.Value, 180)</ToolTip>
                              </ChartDataPoint>
                            </ChartDataPoints>
                            <Type>Range</Type>
                            <Subtype>Bar</Subtype>
                            <ChartAreaName>GanttArea</ChartAreaName>
                            <ValueAxisName>TimeAxis</ValueAxisName>
                            <CategoryAxisName>ProcessAxis</CategoryAxisName>
                            <LegendName>GanttLegend</LegendName>
                          </ChartSeries>
                        </ChartSeriesCollection>
                      </ChartData>
                      <ChartAreas>
                        <ChartArea Name="GanttArea">
                          <ChartCategoryAxes>
                            <ChartAxis Name="ProcessAxis">
                              <Visible>true</Visible>
                              <Style>
                                <FontFamily>=Parameters!FontName.Value</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>#333333</Color>
                              </Style>
                              <ChartAxisTitle>
                                <Caption>Process</Caption>
                                <Style>
                                  <FontFamily>=Parameters!FontName.Value</FontFamily>
                                  <FontSize>8pt</FontSize>
                                  <FontWeight>Bold</FontWeight>
                                  <Color>#1F4E79</Color>
                                </Style>
                              </ChartAxisTitle>
                              <Reverse>true</Reverse>
                              <LabelInterval>1</LabelInterval>
                              <PreventWordWrap>true</PreventWordWrap>
                              <LabelsAutoFitDisabled>false</LabelsAutoFitDisabled>
                              <MinFontSize>7pt</MinFontSize>
                              <MaxFontSize>8pt</MaxFontSize>
                              <ChartMajorGridLines>
                                <Enabled>true</Enabled>
                                <Style>
                                  <Color>#E6E6E6</Color>
                                </Style>
                              </ChartMajorGridLines>
                            </ChartAxis>
                          </ChartCategoryAxes>
                          <ChartValueAxes>
                            <ChartAxis Name="TimeAxis">
                              <Visible>true</Visible>
                              <Style>
                                <FontFamily>=Parameters!FontName.Value</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>#333333</Color>
                              </Style>
                              <ChartAxisTitle>
                                <Caption>Time</Caption>
                                <Style>
                                  <FontFamily>=Parameters!FontName.Value</FontFamily>
                                  <FontSize>8pt</FontSize>
                                  <FontWeight>Bold</FontWeight>
                                  <Color>#1F4E79</Color>
                                </Style>
                              </ChartAxisTitle>
                              <Scalar>true</Scalar>
                              <IncludeZero>false</IncludeZero>
                              <PreventWordWrap>true</PreventWordWrap>
                              <LabelsAutoFitDisabled>false</LabelsAutoFitDisabled>
                              <MinFontSize>7pt</MinFontSize>
                              <MaxFontSize>8pt</MaxFontSize>
                              <ChartMajorGridLines>
                                <Enabled>true</Enabled>
                                <Style>
                                  <Color>#E6E6E6</Color>
                                </Style>
                              </ChartMajorGridLines>
                            </ChartAxis>
                          </ChartValueAxes>
                        </ChartArea>
                      </ChartAreas>
                      <ChartLegends>
                        <ChartLegend Name="GanttLegend">
                          <Position>Bottom</Position>
                          <DockToChartArea>GanttArea</DockToChartArea>
                          <DockOutsideChartArea>true</DockOutsideChartArea>
                          <TextWrapThreshold>25</TextWrapThreshold>
                          <Style>
                            <FontFamily>=Parameters!FontName.Value</FontFamily>
                            <FontSize>8pt</FontSize>
                            <Color>#333333</Color>
                          </Style>
                        </ChartLegend>
                      </ChartLegends>
                      <ChartTitles>
                        <ChartTitle Name="GanttTitle">
                          <Caption>Process timeline</Caption>
                          <Style>
                            <FontFamily>=Parameters!FontName.Value</FontFamily>
                            <FontSize>11pt</FontSize>
                            <FontWeight>Bold</FontWeight>
                            <Color>#1F4E79</Color>
                          </Style>
                        </ChartTitle>
                      </ChartTitles>
                      <Palette>Custom</Palette>
                      <ChartCustomPaletteColors>
                        <ChartCustomPaletteColor>#4F81BD</ChartCustomPaletteColor>
                        <ChartCustomPaletteColor>#C0504D</ChartCustomPaletteColor>
                        <ChartCustomPaletteColor>#9BBB59</ChartCustomPaletteColor>
                        <ChartCustomPaletteColor>#8064A2</ChartCustomPaletteColor>
                        <ChartCustomPaletteColor>#4BACC6</ChartCustomPaletteColor>
                        <ChartCustomPaletteColor>#F79646</ChartCustomPaletteColor>
                        <ChartCustomPaletteColor>#1F4E79</ChartCustomPaletteColor>
                        <ChartCustomPaletteColor>#7F7F7F</ChartCustomPaletteColor>
                        <ChartCustomPaletteColor>#31859C</ChartCustomPaletteColor>
                        <ChartCustomPaletteColor>#D99694</ChartCustomPaletteColor>
                        <ChartCustomPaletteColor>#C4BD97</ChartCustomPaletteColor>
                        <ChartCustomPaletteColor>#B3A2C7</ChartCustomPaletteColor>
                      </ChartCustomPaletteColors>
                      <ChartNoDataMessage Name="GanttEmpty">
                        <Caption>No processes in this window.</Caption>
                      </ChartNoDataMessage>
                      <DynamicHeight>=(1.6 + CountRows("Processes") * 0.28) &amp; "in"</DynamicHeight>
                      <Height>3.60in</Height>
                      <Width>10.50in</Width>
                    </Chart>
                  </CellContents>
                </TablixCell>
              </TablixCells>
            </TablixRow>
            <TablixRow>
              <Height>0.36in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="txtGanttNote">
                      <Height>0.32in</Height>
                      <Width>10.5in</Width>
                      <Style>
                        <FontFamily>=Parameters!FontName.Value</FontFamily>
                        <FontSize>8pt</FontSize>
                        <TextAlign>Left</TextAlign>
                        <VerticalAlign>Top</VerticalAlign>
                        <Color>#595959</Color>
                        <PaddingLeft>2pt</PaddingLeft>
                        <PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop>
                        <PaddingBottom>1pt</PaddingBottom>
                      </Style>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Each bar runs from FirstStart to LastEnd and is colored by application. The earliest process is at the top. Hover a bar for elapsed seconds, busy percent, and the main statement.</Value>
                            </TextRun>
                          </TextRuns>
