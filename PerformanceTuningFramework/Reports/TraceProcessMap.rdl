<?xml version='1.0' encoding='utf-8'?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition">
  <Description>SSMS custom report for dbo.ShowTraceProcessMap and dbo.ShowTraceSourceBreakdown. RDL 2008. SSMS supplies the connection and ignores this data source connection string.</Description>
  <Author>Performance Tuning Framework</Author>
  <ConsumeContainerWhitespace>true</ConsumeContainerWhitespace>
  <Language>en-US</Language>
  <Code>Public Function BusyBar(ByVal pct As Object) As String
    Dim n As Integer
    If IsNothing(pct) Then Return ""
    n = CInt(Int(CDbl(pct) / 10.0 + 0.5))
    If n &lt; 0 Then n = 0
    If n &gt; 10 Then n = 10
    Return Left("##########", n)
End Function

Public Function ShareBar(ByVal part As Object, ByVal whole As Object) As String
    Dim n As Integer
    If IsNothing(part) OrElse IsNothing(whole) Then Return ""
    If CDbl(whole) = 0 Then Return ""
    n = CInt(Int((CDbl(part) / CDbl(whole)) * 10.0 + 0.5))
    If n &lt; 0 Then n = 0
    If n &gt; 10 Then n = 10
    Return Left("##########", n)
End Function

Public Function Clip(ByVal text As Object, ByVal n As Integer) As String
    Dim s As String
    If IsNothing(text) Then Return ""
    s = CStr(text)
    s = Replace(s, vbCrLf, " ")
    s = Replace(s, vbLf, " ")
    s = Replace(s, vbCr, " ")
    s = Replace(s, vbTab, " ")
    If n &lt; 1 Then Return ""
    If Len(s) &lt;= n Then Return s
    If n &lt;= 3 Then Return Left(s, n)
    Return Left(s, n - 3) &amp; "..."
End Function

Public Function Fmt(ByVal value As Object, ByVal formatText As String) As String
    If IsNothing(value) Then Return ""
    Return Format(value, formatText)
End Function
</Code>
  <DataSources>
    <DataSource Name="TraceData">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=.</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Overview">
      <Query>
        <DataSourceName>TraceData</DataSourceName>
        <CommandType>Text</CommandType>
        <CommandText>EXEC dbo.ShowTraceProcessMap
    @TraceTable = @TraceTable,
    @StartTime = @StartTime,
    @EndTime = @EndTime,
    @DatabaseName = @DatabaseName,
    @ApplicationName = @ApplicationName,
    @ReturnOverview = 1,
    @ReturnProcesses = 0,
    @ReturnSteps = 0,
    @ReturnTimeline = 0,
    @ReturnGantt = 0,
    @ReturnTopStatements = 0
</CommandText>
        <QueryParameters>
          <QueryParameter Name="@TraceTable">
            <Value DataType="String">=Parameters!TraceTable.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@StartTime">
