<?xml version='1.0' encoding='utf-8'?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition">
  <Description>SSMS custom report for dbo.ShowTraceProcessMap and dbo.ShowTraceSourceBreakdown. RDL 2008. SSMS supplies the connection and ignores this data source connection string.</Description>
  <Author>Performance Tuning Framework</Author>
  <ConsumeContainerWhitespace>true</ConsumeContainerWhitespace>
  <Language>en-US</Language>
  <Code>Public Function BusyBar(ByVal pct As Object) As String
    Dim n As Integer
    If IsNothing(pct) Then Return ""
    n = CInt(Int(CDbl(pct) / 10.0 + 0.5))
    If n &lt; 0 Then n = 0
    If n &gt; 10 Then n = 10
    Return Left("##########", n)
End Function

Public Function ShareBar(ByVal part As Object, ByVal whole As Object) As String
    Dim n As Integer
    If IsNothing(part) OrElse IsNothing(whole) Then Return ""
    If CDbl(whole) = 0 Then Return ""
    n = CInt(Int((CDbl(part) / CDbl(whole)) * 10.0 + 0.5))
    If n &lt; 0 Then n = 0
    If n &gt; 10 Then n = 10
    Return Left("##########", n)
End Function

Public Function Clip(ByVal text As Object, ByVal n As Integer) As String
    Dim s As String
    If IsNothing(text) Then Return ""
    s = CStr(text)
    s = Replace(s, vbCrLf, " ")
    s = Replace(s, vbLf, " ")
    s = Replace(s, vbCr, " ")
    s = Replace(s, vbTab, " ")
    If n &lt; 1 Then Return ""
    If Len(s) &lt;= n Then Return s
    If n &lt;= 3 Then Return Left(s, n)
    Return Left(s, n - 3) &amp; "..."
End Function

Public Function Fmt(ByVal value As Object, ByVal formatText As String) As String
    If IsNothing(value) Then Return ""
    Return Format(value, formatText)
End Function

Public Function QuoteIdent(ByVal name As String) As String
    Return "[" &amp; Replace(name, "]", "]]") &amp; "]"
End Function

Public Function TraceTableFromContext(ByVal objectType As Object, ByVal objectName As Object) As String
    Dim t As String
    Dim n As String
    Dim parts() As String
    Dim i As Integer
    Dim built As String
    If IsNothing(objectType) OrElse IsNothing(objectName) Then Return ""
    t = Trim(CStr(objectType))
    n = Trim(CStr(objectName))
    If Len(n) = 0 Then Return ""
    If StrComp(t, "Table", CompareMethod.Text) &lt;&gt; 0 AndAlso StrComp(t, "UserTable", CompareMethod.Text) &lt;&gt; 0 Then Return ""
    n = Replace(Replace(n, "[", ""), "]", "")
    If InStr(n, ".") = 0 Then n = "dbo." &amp; n
    parts = Split(n, ".")
    built = ""
    For i = 0 To UBound(parts)
        If Len(Trim(parts(i))) = 0 Then Return ""
        If Len(built) &gt; 0 Then built = built &amp; "."
        built = built &amp; QuoteIdent(Trim(parts(i)))
    Next
    Return built
End Function
</Code>
  <DataSources>
    <DataSource Name="TraceData">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=.</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Overview">
      <Query>
        <DataSourceName>TraceData</DataSourceName>
        <CommandType>Text</CommandType>
        <CommandText>SET NOCOUNT ON;
IF NULLIF(@TraceTable, N'') IS NULL
SELECT
    TraceTable     = CONVERT(nvarchar(1000), NULL),
    CapturedFrom   = CONVERT(datetime, NULL),
    CapturedTo     = CONVERT(datetime, NULL),
    ElapsedSeconds = CONVERT(decimal(18, 3), NULL),
    EventCount     = CONVERT(int, NULL),
    ProcessCount   = CONVERT(int, NULL),
    BusySeconds    = CONVERT(decimal(18, 3), NULL),
    BusyCpuSeconds = CONVERT(decimal(18, 3), NULL),
    DurationNote   = CONVERT(nvarchar(max), NULL),
    BusyRule       = CONVERT(nvarchar(max), NULL),
    FilterNote     = CONVERT(nvarchar(max), NULL)
WHERE 1 = 0
ELSE
EXEC dbo.ShowTraceProcessMap
    @TraceTable = @TraceTable,
    @StartTime = @StartTime,
    @EndTime = @EndTime,
    @DatabaseName = @DatabaseName,
    @ApplicationName = @ApplicationName,
    @ReturnOverview = 1,
    @ReturnProcesses = 0,
    @ReturnSteps = 0,
    @ReturnTimeline = 0,
    @ReturnGantt = 0,
    @ReturnTopStatements = 0
</CommandText>
        <QueryParameters>
          <QueryParameter Name="@TraceTable">
            <Value DataType="String">=Parameters!TraceTable.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@StartTime">
            <Value DataType="DateTime">=Parameters!StartTime.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndTime">
            <Value DataType="DateTime">=Parameters!EndTime.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@DatabaseName">
            <Value DataType="String">=Parameters!DatabaseFilter.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@ApplicationName">
            <Value DataType="String">=Parameters!ApplicationName.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <Timeout>600</Timeout>
      </Query>
      <Fields>
        <Field Name="TraceTable">
          <DataField>TraceTable</DataField>
        </Field>
        <Field Name="CapturedFrom">
          <DataField>CapturedFrom</DataField>
        </Field>
        <Field Name="CapturedTo">
          <DataField>CapturedTo</DataField>
        </Field>
        <Field Name="ElapsedSeconds">
          <DataField>ElapsedSeconds</DataField>
        </Field>
        <Field Name="EventCount">
          <DataField>EventCount</DataField>
        </Field>
        <Field Name="ProcessCount">
          <DataField>ProcessCount</DataField>
        </Field>
        <Field Name="BusySeconds">
          <DataField>BusySeconds</DataField>
        </Field>
        <Field Name="BusyCpuSeconds">
          <DataField>BusyCpuSeconds</DataField>
        </Field>
        <Field Name="DurationNote">
          <DataField>DurationNote</DataField>
        </Field>
        <Field Name="BusyRule">
          <DataField>BusyRule</DataField>
        </Field>
        <Field Name="FilterNote">
          <DataField>FilterNote</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Processes">
      <Query>
        <DataSourceName>TraceData</DataSourceName>
        <CommandType>Text</CommandType>
        <CommandText>SET NOCOUNT ON;
IF NULLIF(@TraceTable, N'') IS NULL
SELECT
    ProcessId       = CONVERT(int, NULL),
    FirstStart      = CONVERT(datetime, NULL),
    LastEnd         = CONVERT(datetime, NULL),
    ElapsedSeconds  = CONVERT(decimal(18, 3), NULL),
    BusySeconds     = CONVERT(decimal(18, 3), NULL),
    BusyPercent     = CONVERT(decimal(9, 1), NULL),
    CpuSeconds      = CONVERT(decimal(18, 3), NULL),
    Reads           = CONVERT(bigint, NULL),
    Writes          = CONVERT(bigint, NULL),
    RowCounts       = CONVERT(bigint, NULL),
    WorkEventCount  = CONVERT(int, NULL),
    MaxConcurrent   = CONVERT(int, NULL),
    SPID            = CONVERT(int, NULL),
    ApplicationName = CONVERT(nvarchar(128), NULL),
    HostName        = CONVERT(nvarchar(128), NULL),
    LoginName       = CONVERT(nvarchar(128), NULL),
    PrimaryDatabase = CONVERT(nvarchar(128), NULL),
    MainObject      = CONVERT(nvarchar(128), NULL),
    MainStatement   = CONVERT(nvarchar(400), NULL),
    ProcessLabel    = CONVERT(nvarchar(500), NULL)
WHERE 1 = 0
ELSE
EXEC dbo.ShowTraceProcessMap
    @TraceTable = @TraceTable,
    @StartTime = @StartTime,
    @EndTime = @EndTime,
    @DatabaseName = @DatabaseName,
    @ApplicationName = @ApplicationName,
    @ReturnOverview = 0,
    @ReturnProcesses = 1,
    @ReturnSteps = 0,
    @ReturnTimeline = 0,
    @ReturnGantt = 0,
    @ReturnTopStatements = 0
</CommandText>
